                                    {
                                      "type": "frame",
                                      "id": "AnlLC",
                                      "name": "p",
                                      "context": "p",
                                      "width": "fill_container",
                                      "height": 690,
                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "U8d0o",
                                          "name": "If you believe you belong to any of the ",
                                          "fill": "#000000",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "If you believe you belong to any of the categories of protected veterans listed below, please indicate by making the appropriate selection. As a government contractor subject to Vietnam Era Veterans Readjustment Assistance Act (VEVRAA), we request this information in order to measure the effectiveness of the outreach and positive recruitment efforts we undertake pursuant to VEVRAA. Classification of protected categories is as follows:",
                                          "lineHeight": 1.47,
                                          "fontFamily": "ripplingFontNormal",
                                          "fontSize": 15,
                                          "fontWeight": "normal",
                                          "letterSpacing": 0.5
                                        },
                                        {
                                          "type": "rectangle",
                                          "id": "aPhFT",
                                          "name": "div",
                                          "context": "div",
                                          "width": "fill_container",
                                          "height": 24
                                        },
                                        {
                                          "type": "text",
                                          "id": "vFUII",
                                          "name": "A \"disabled veteran\" is one of the follo",
                                          "fill": "#000000",
                                          "textGrowth": "fixed-width",
                                          "width": 482.31,
                                          "content": "A \"disabled veteran\" is one of the following: a veteran of the U.S. military, ground, naval or air service who is entitled to compensation (or who but for the receipt of military retired pay would be entitled to compensation) under laws administered by the Secretary of Veterans Affairs; or a person who was discharged or released from active duty because of a service-connected disability.",
                                          "lineHeight": 1.47,
                                          "fontFamily": "ripplingFontNormal",
                                          "fontSize": 15,
                                          "fontWeight": "normal",
                                          "letterSpacing": 0.5
                                        },
                                        {
                                          "type": "rectangle",
                                          "id": "G3LlHR",
                                          "name": "div",
                                          "context": "div",
                                          "width": "fill_container",
                                          "height": 24
                                        },
                                        {
                                          "type": "text",
                                          "id": "clPJ2",
                                          "name": "A \"recently separated veteran\" means any",
                                          "fill": "#000000",
                                          "textGrowth": "fixed-width",
                                          "width": 466.66,
                                          "content": "A \"recently separated veteran\" means any veteran during the three-year period beginning on the date of such veteran's discharge or release from active duty in the U.S. military, ground, naval, or air service.",
                                          "lineHeight": 1.47,
                                          "fontFamily": "ripplingFontNormal",
                                          "fontSize": 15,
                                          "fontWeight": "normal",
                                          "letterSpacing": 0.5
                                        },
                                        {
                                          "type": "rectangle",
                                          "id": "xFgE4",
                                          "name": "div",
                                          "context": "div",
                                          "width": "fill_container",
                                          "height": 24
                                        },
                                        {
                                          "type": "text",
                                          "id": "XZXCA",
                                          "name": "An \"active duty wartime or campaign badg",
                                          "fill": "#000000",
                                          "textGrowth": "fixed-width",
                                          "width": 485.72,
                                          "content": "An \"active duty wartime or campaign badge veteran\" means a veteran who served on active duty in the U.S. military, ground, naval or air service during a war, or in a campaign or expedition for which a campaign badge has been authorized under the laws administered by the Department of Defense.",
                                          "lineHeight": 1.47,
                                          "fontFamily": "ripplingFontNormal",
                                          "fontSize": 15,
                                          "fontWeight": "normal",
                                          "letterSpacing": 0.5
                                        },
                                        {
                                          "type": "rectangle",
                                          "id": "JSzSH",
                                          "name": "div",
                                          "context": "div",
                                          "width": "fill_container",
                                          "height": 24
                                        },
                                        {
                                          "type": "text",
                                          "id": "G8SnOf",
                                          "name": "An \"Armed forces service medal veteran\" ",
                                          "fill": "#000000",
                                          "textGrowth": "fixed-width",
                                          "width": 480.89,
                                          "content": "An \"Armed forces service medal veteran\" means a veteran who, while serving on active duty in the U.S. military, ground, naval or air service, participated in a United States military operation for which an Armed Forces service medal was awarded pursuant to Executive Order 12985.",
                                          "lineHeight": 1.47,
                                          "fontFamily": "ripplingFontNormal",
                                          "fontSize": 15,
                                          "fontWeight": "normal",
                                          "letterSpacing": 0.5
                                        }
                                      ]
                                    }
                                  ]
