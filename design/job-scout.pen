                                                                              "gap": 14,
                                                                              "children": [
                                                                                {
                                                                                  "type": "text",
                                                                                  "id": "SUC8d",
                                                                                  "name": "Senior Software Engineer",
                                                                                  "context": "span",
                                                                                  "fill": "#000000",
                                                                                  "content": "Senior Software Engineer",
                                                                                  "lineHeight": 1.23,
                                                                                  "fontFamily": "Inter",
                                                                                  "fontSize": 13,
                                                                                  "fontWeight": "normal"
                                                                                },
                                                                                {
                                                                                  "type": "frame",
                                                                                  "id": "VK9AK",
                                                                                  "name": "div",
                                                                                  "context": "div",
                                                                                  "width": "fill_container",
                                                                                  "layout": "vertical",
                                                                                  "gap": 8,
                                                                                  "children": [
                                                                                    {
                                                                                      "type": "text",
                                                                                      "id": "o5x54x",
                                                                                      "name": "• Delivered the authorized account acces",
                                                                                      "context": "span",
                                                                                      "fill": "#000000",
                                                                                      "textGrowth": "fixed-width-height",
                                                                                      "width": "fill_container",
                                                                                      "height": 32,
                                                                                      "content": "• Delivered the authorized account access system end to end, coordinating requirements across 4+ teams and partnering with a principal engineer; cut monthly support tickets 30% (about $400K saved annually) and reduced escalation resolution time 20%.",
                                                                                      "lineHeight": 1.23,
                                                                                      "fontFamily": "Inter",
                                                                                      "fontSize": 13,
                                                                                      "fontWeight": "normal"
                                                                                    },
                                                                                    {
                                                                                      "type": "text",
                                                                                      "id": "ss2z6",
                                                                                      "name": "• Took ownership of test automation for ",
                                                                                      "context": "span",
                                                                                      "fill": "#000000",
                                                                                      "textGrowth": "fixed-width-height",
                                                                                      "width": "fill_container",
                                                                                      "height": 32,
                                                                                      "content": "• Took ownership of test automation for the entire auth surface after a reorg left the team without dedicated QA, driving automated E2E feature coverage from ~70% to 100%, including a custom-domain workaround that made email and MFA flows automatable.",
                                                                                      "lineHeight": 1.23,
                                                                                      "fontFamily": "Inter",
                                                                                      "fontSize": 13,
                                                                                      "fontWeight": "normal"
                                                                                    },
                                                                                    {
                                                                                      "type": "text",
                                                                                      "id": "eAdmm",
                                                                                      "name": "• Cut recurring nightly E2E failures fro",
                                                                                      "context": "span",
                                                                                      "fill": "#000000",
                                                                                      "textGrowth": "fixed-width-height",
                                                                                      "width": "fill_container",
                                                                                      "height": 48,
                                                                                      "content": "• Cut recurring nightly E2E failures from a 10-per-day baseline to zero chronic failures: designed the weekly classification and ownership model, root-caused 20 recurring failures to three shared defects in common helpers, and shipped an AI-assisted triage tool that took investigation from hours to minutes.",
                                                                                      "lineHeight": 1.23,
                                                                                      "fontFamily": "Inter",
                                                                                      "fontSize": 13,
                                                                                      "fontWeight": "normal"
                                                                                    },
                                                                                    {
                                                                                      "type": "text",
                                                                                      "id": "It7Yy",
                                                                                      "name": "• Owned end-to-end delivery of Generativ",
                                                                                      "context": "span",
                                                                                      "fill": "#000000",
                                                                                      "textGrowth": "fixed-width-height",
                                                                                      "width": "fill_container",
                                                                                      "height": 48,
                                                                                      "content": "• Owned end-to-end delivery of Generative AI Domain Settings, letting enterprise admins govern every AI feature in their domain from a single control; drove backend API design across an ML-services dependency, passed security review, and unblocked enterprise deals that require AI governance.",
                                                                                      "lineHeight": 1.23,
                                                                                      "fontFamily": "Inter",
                                                                                      "fontSize": 13,
                                                                                      "fontWeight": "normal"
                                                                                    },
                                                                                    {
                                                                                      "type": "text",
                                                                                      "id": "A3r6Gh",
                                                                                      "name": "• Rebuilt enterprise authentication sett",
                                                                                      "context": "span",
                                                                                      "fill": "#000000",
                                                                                      "textGrowth": "fixed-width-height",
                                                                                      "width": "fill_container",
                                                                                      "height": 64,
                                                                                      "content": "• Rebuilt enterprise authentication settings (SSO/SAML/OIDC, provisioning, password policy) from modal-based configuration into a routed multi-tab React form with Formik/Yup validation, React Query state, and unsaved-change guards; owned OIDC project end to end, including Ruby sign-in controllers and client-secret masking, shipping across multiple releases to unblock strategic enterprise accounts.",
                                                                                      "lineHeight": 1.23,
                                                                                      "fontFamily": "Inter",
                                                                                      "fontSize": 13,
                                                                                      "fontWeight": "normal"
                                                                                    },
                                                                                    {
                                                                                      "type": "text",
                                                                                      "id": "YzBRd",
                                                                                      "name": "• Migrated the core authentication flow ",
                                                                                      "context": "span",
                                                                                      "fill": "#000000",
                                                                                      "textGrowth": "fixed-width-height",
                                                                                      "width": "fill_container",
                                                                                      "height": 32,
                                                                                      "content": "• Migrated the core authentication flow from legacy Backbone.js to React and championed TypeScript adoption across new front-end work to reduce runtime errors.",
                                                                                      "lineHeight": 1.23,
                                                                                      "fontFamily": "Inter",
                                                                                      "fontSize": 13,
                                                                                      "fontWeight": "normal"
                                                                                    },
                                                                                    {
                                                                                      "type": "text",
                                                                                      "id": "hPT6T",
                                                                                      "name": "• Created the team's release sign-off ru",
                                                                                      "context": "span",
                                                                                      "fill": "#000000",
                                                                                      "textGrowth": "fixed-width-height",
                                                                                      "width": "fill_container",
                                                                                      "height": 32,
                                                                                      "content": "• Created the team's release sign-off runbook and on-call rotation, giving engineers a shadowing path into release triage; mentored a junior engineer and supported a new-hire project lead through requirements, test planning, and delivery.",
                                                                                      "lineHeight": 1.23,
                                                                                      "fontFamily": "Inter",
                                                                                      "fontSize": 13,
                                                                                      "fontWeight": "normal"
                                                                                    }
                                                                                  ]
                                                                                }
                                                                              ]
                                                                            }
                                                                          ]
                                                                        }
                                                                      ]
                                                                    }
                                                                  ]
