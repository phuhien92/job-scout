/** Generate Job Scout's approved light tokens from design/job-scout.pen. */
import { readFileSync, writeFileSync } from "node:fs";
import { join, relative } from "node:path";

const ROOT = join(import.meta.dirname, "..");
const PEN = join(ROOT, "design/job-scout.pen");
const OUTPUT = join(ROOT, "src/styles/tokens.css");
type ThemeValue = { value: string | number; theme: { mode: string } };
type Variable = { type: "color" | "number" | "string"; value: string | number | ThemeValue[] };
type PenDocument = { themes?: { mode?: string[] }; variables?: Record<string, Variable> };

const SURFACES = ["bg-page", "bg-panel", "bg-raised", "bg-control"];
const CONTRAST_PAIRS = [
  ...["text-primary", "text-secondary", "text-tertiary"].flatMap((text) =>
    SURFACES.map((surface) => [text, surface] as const),
  ),
  ["accent-text", "accent"],
  ["positive-text", "positive-bg"],
  ["warning-text", "warning-bg"],
  ["error-text", "error-bg"],
] as const;

function invalid(message: string): never {
  throw new Error(`Invalid Pen token data: ${message}`);
}

function tokenName(name: string): string {
  if (!/^[a-z][a-z0-9-]*$/.test(name)) invalid(`unsupported variable name "${name}"`);
  return `--js-${name}`;
}

function tokenValue(name: string, type: Variable["type"], value: string | number): string {
  if (type === "color") {
    if (typeof value !== "string" || !/^#[0-9A-Fa-f]{6}$/.test(value)) invalid(`${name} must be a hex color`);
    return value.toUpperCase();
  }
  if (type === "string") {
    if (typeof value !== "string") invalid(`${name} must be a string`);
    return JSON.stringify(value);
  }
  if (typeof value !== "number" || !Number.isFinite(value)) invalid(`${name} must be a finite number`);
  return /^(radius|space)-/.test(name) ? `${value}px` : String(value);
}

function render(document: PenDocument): string {
  if (!document.themes?.mode?.includes("light")) invalid('themes.mode is missing "light"');
  if (!document.variables || Object.keys(document.variables).length === 0) invalid("variables are missing");
  const declarations = Object.keys(document.variables).sort().map((name) => {
    const variable = document.variables![name];
    const values = Array.isArray(variable.value)
      ? variable.value.filter((item) => item.theme?.mode === "light")
      : [{ value: variable.value }];
    if (values.length !== 1) invalid(`${name} must define exactly one light value`);
    return `  ${tokenName(name)}: ${tokenValue(name, variable.type, values[0].value)};`;
  });
  return `/* Generated by scripts/design-tokens.mts from the approved light variables in design/job-scout.pen.\n * Dark Pen values are dormant design data and are intentionally not emitted.\n * Do not edit by hand; run \`npm run tokens:generate\`.\n */\n\n:root {\n${declarations.join("\n")}\n}\n`;
}

function luminance(hex: string): number {
  const [red, green, blue] = hex.slice(1).match(/../g)!.map((channel) => {
    const value = Number.parseInt(channel, 16) / 255;
    return value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * red + 0.7152 * green + 0.0722 * blue;
}

function verifyContrast(css: string): number {
  const block = /:root\s*\{([^}]*)\}/.exec(css)?.[1];
  if (!block) throw new Error("Generated token CSS is missing its :root block.");
  const colors = new Map(
    [...block.matchAll(/--js-([a-z0-9-]+):\s*(#[0-9A-Fa-f]{6});/g)].map((match) => [match[1], match[2]]),
  );
  for (const [foreground, background] of CONTRAST_PAIRS) {
    const foregroundValue = colors.get(foreground);
    const backgroundValue = colors.get(background);
    if (!foregroundValue || !backgroundValue) throw new Error(`Missing ${foreground} or ${background}.`);
    const light = luminance(foregroundValue);
    const dark = luminance(backgroundValue);
    const ratio = (Math.max(light, dark) + 0.05) / (Math.min(light, dark) + 0.05);
    if (ratio < 4.5) throw new Error(`${foreground} on ${background} is ${ratio.toFixed(2)}:1; AA needs 4.5:1.`);
  }
  return CONTRAST_PAIRS.length;
}

const expected = render(JSON.parse(readFileSync(PEN, "utf8")) as PenDocument);
if (process.argv.includes("--check")) {
  let current = "";
  try {
    current = readFileSync(OUTPUT, "utf8");
  } catch {}
  if (current !== expected) {
    console.error(`${relative(ROOT, OUTPUT)} is out of date. Run: npm run tokens:generate`);
    process.exit(1);
  }
  console.log(`Design tokens are up to date; ${verifyContrast(current)} light text pairs pass WCAG AA.`);
} else {
  writeFileSync(OUTPUT, expected);
  console.log(`Wrote ${relative(ROOT, OUTPUT)}; ${verifyContrast(expected)} light text pairs pass WCAG AA.`);
}
